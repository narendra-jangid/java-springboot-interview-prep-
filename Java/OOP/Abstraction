Q15.
Predict the output.

Code:
interface Logger {
    default void log(String m) {
        System.out.print("Logger:" + m + " ");
    }
}

abstract class Base implements Logger {
    public void log(String m) {
        System.out.print("Base:" + m + " ");
    }

    abstract void run();
}

class Task extends Base implements Logger {
    void run() {
        log("go");
    }

    public void log(String m) {
        super.log(m);
        System.out.print("Task:" + m + " ");
    }
}

// inside main
Base b = new Task();

b.run();

A. Base:go Task:go
B. Task:go Base:go
C. Logger:go Task:go
D. Compilation error
